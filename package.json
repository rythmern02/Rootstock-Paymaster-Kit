{
  "name": "rsk-erc4337",
  "version": "1.0.0",
  "description": "A production-ready ERC-4337 Account Abstraction and gasless transaction toolkit for the Rootstock (RSK) network, featuring a VerifyingPaymaster that lets users pay gas in ERC-20 tokens.",
  "main": "index.js",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "setup": "tsx offchain/setupPaymaster.ts",
    "execute:op": "tsx offchain/executeUserOp.ts",
    "forge:test": "forge test -vv",
    "forge:build": "forge build",
    "typecheck": "tsc --noEmit",
    "test": "forge test -vv && tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.3.1",
    "tslib": "^2.8.1",
    "viem": "^2.46.2"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}